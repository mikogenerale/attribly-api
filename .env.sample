# Create a .env.local file based on this sample and fill in the values for your environment.

API_PORT=<your-api-port>
UI_PORT=<your-ui-port>
UI_URL=http://localhost:${UI_PORT}

# Supabase direct connection configuration
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
BETTER_AUTH_URL=http://localhost:${API_PORT}

# Resend configuration
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=Attribly <no-reply@yourdomain.com>

# Google OAuth configuration
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>


# BigQuery configuration
BIGQUERY_QUERY_PROJECT_ID=your-app-project-id